{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dr-evaldo-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "env": {
    "staging": {
      "name": "dr-evaldo-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    }
  }
}
